[ req ]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[ dn ]
C = US
ST = California
L = San Francisco
O = My Company
OU = My Division
CN = mydomain.com

[ req_ext ]
subjectAltName = @alt_names
keyUsage = digitalSignature, keyAgreement
extendedKeyUsage = serverAuth, clientAuth

[ alt_names ]
DNS.1 = web.lab.com
